# Coolify environment for iskina-sme.
# Paste into the Coolify resource (or upload as an env file). Never commit real values.

# --- Database (the compose stack creates its own Postgres) ---
POSTGRES_USER=iskina
POSTGRES_PASSWORD=change-me-alphanumeric
POSTGRES_DB=iskina_sme

# Application role: non-superuser, so RLS is enforced. Alphanumeric only.
DB_APP_USER=iskina_app
DB_APP_PASSWORD=change-me-alphanumeric-app

# --- Public URL ---
# The domain you attach to the `web` service in Coolify.
APP_URL=https://sme.iskina.ph

# --- Sessions ---
# openssl rand -hex 32
AUTH_SECRET=
SESSION_TTL_DAYS=30
# Keep false in production: dev OTP codes are returned by the API.
AUTH_EXPOSE_DEV_OTP=false
# Staging only: generate codes locally instead of calling iskina-otp.
# Requires AUTH_EXPOSE_DEV_OTP=true to see the code. Never enable in production.
AUTH_ALLOW_DEV_OTP=false

# --- OTP delivery (required for production sign-in) ---
ISKINA_OTP_BASE_URL=https://dev-otp.iskina.ph
ISKINA_OTP_API_KEY=
# ISKINA_OTP_PHONE_CHANNEL=sms   # sms | whatsapp | viber

# --- Theme ---
THEME_DEFAULT_PRESET=alibaba

# --- Push (optional until the merchant app ships) ---
FCM_SERVER_KEY=

# --- First deploy ---
# Keep false in production. Demo tenants are for local/staging only.
SEED_DEMO_DATA=false
