# Local development
# The app connects as a non-superuser role so RLS is enforced locally too.
# Fresh volumes get this role from db/init; reset once after upgrading:
#   docker compose down -v && pnpm db:up
DATABASE_URL=postgres://iskina_app:iskina_app@localhost:5437/iskina_sme
DB_APP_USER=iskina_app
DB_APP_PASSWORD=iskina_app
# Superuser URL for the RLS integration test only. Never use it for the app.
DATABASE_ADMIN_URL=postgres://iskina:iskina@localhost:5437/iskina_sme
NEXT_PUBLIC_APP_URL=http://localhost:3008

# Sessions (M1)
AUTH_SECRET=
# Dev only: return the OTP in the API response. Defaults to on outside production.
AUTH_EXPOSE_DEV_OTP=true
# Staging only: generate codes locally even when NODE_ENV=production.
AUTH_ALLOW_DEV_OTP=false
SESSION_TTL_DAYS=30

# Theme: preset id used for businesses that have not branded themselves yet
THEME_DEFAULT_PRESET=alibaba

# OTP delegation (M1) — see iskina-otp
ISKINA_OTP_BASE_URL=https://dev-otp.iskina.ph
ISKINA_OTP_API_KEY=

# Push (M3c) — FCM legacy server key; unset logs and skips
FCM_SERVER_KEY=
